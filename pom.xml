<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.dash198</groupId>
    <artifactId>aarithmetic</artifactId>
    <version>1.6</version> 
    <packaging>jar</packaging>   

    <name>Arbitrary Precision Arithmetic</name>
    <description>A Java library for arbitrary precision integer and float arithmetic, created as the final project for the CS1023 - Software Development Fundamentals Course at IIT Hyderabad.</description>
    <url>https://github.com/Dash198/CS1023-Final-Project</url>

    <developers>
        <developer>
            <id>chakramsiri</id>
            <name>Chakram Siri</name>
            <email>cs24btech11017</email>
        </developer>
    </developers>

    <build>
        <finalName>aarithmetic</finalName>
        <plugins>
            <!-- Maven Compiler Plugin to compile the code -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <source>21</source>
                    <target>21</target> 
                </configuration>
            </plugin>

            <!-- Exec Maven Plugin to run the main class -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <!-- Specify the fully-qualified name of the main class -->
                            <mainClass>MyInfArith</mainClass> <!-- Change this if your main class is in a package -->
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
